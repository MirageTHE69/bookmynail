{
  "name": "bookmynail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:push:prod": "dotenv -e .env.production.local -- drizzle-kit push",
    "db:seed:prod": "dotenv -e .env.production.local -- tsx scripts/seed.ts",
    "db:studio:prod": "dotenv -e .env.production.local -- drizzle-kit studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "setup": "npm run db:push && npm run db:seed && npm run admin:create"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.3.19",
    "jose": "^6.2.8",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4"
  }
}
