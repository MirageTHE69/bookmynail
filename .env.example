# Copy to .env.local for development. Never commit the filled-in files —
# .gitignore already excludes .env*.local.

# ── Database ────────────────────────────────────────────────────────
# Development: a local SQLite file (no auth token needed).
DATABASE_URL=file:./data/bookmynail.db
DATABASE_AUTH_TOKEN=

# Production values live in .env.production.local and in the host's env vars:
#   DATABASE_URL=libsql://bookmynail-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso token>

# ── Admin login ─────────────────────────────────────────────────────
# Generate all three with: npm run admin:create
# ADMIN_PASSWORD_HASH is a bcrypt hash stored base64-encoded, because dotenv's
# variable expansion would otherwise eat the `$` characters in a raw hash.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# ── Image uploads (needed once deployed) ────────────────────────────
# Serverless filesystems are read-only, so portfolio uploads go to Cloudinary.
# Copy the "API Environment variable" from the Cloudinary dashboard as-is.
CLOUDINARY_URL=

# ImageKit — stores portfolio images and payment screenshots.
# Dashboard → Developer options → API keys.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/5feqwwaxb
